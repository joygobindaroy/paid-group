# ======================================================================
#  Paid Group Access Page - environment variables
#  Vercel: Project > Settings > Environment Variables (add each one, then Redeploy)
#  Local test: copy this file to ".env" and fill it in. NEVER commit ".env" or share it.
#  Group ID, price, wallet addresses, theme and support link are NOT here:
#  set them later in the admin panel (yoursite.vercel.app/admin).
# ======================================================================

# ---- 1. Admin panel login -------------------------------------------
# Choose a long password (16+ characters). Used at /admin
ADMIN_PASSWORD=

# ---- 2. Telegram bot ------------------------------------------------
# From @BotFather after /newbot. Looks like 123456789:AAH...
TG_BOT_TOKEN=
# Any random text you invent. Letters, numbers, _ and - only. 20+ characters.
TG_WEBHOOK_SECRET=

# ---- 3. Binance API (READ-ONLY key) ---------------------------------
# Binance > Profile > API Management > Create API.
# Tick ONLY "Enable Reading". Do NOT enable trading or withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- 4. Database: use ONE option ------------------------------------
# Option A (easiest if signup works): Upstash Redis.
# upstash.com > Create Database > "REST API" section > copy the two values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option B: Vercel Marketplace > Upstash Redis integration.
# Vercel adds these two for you. Leave Option A empty then.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Option C: Firebase Realtime Database (no Upstash account needed).
# 1) console.firebase.google.com > create project > Build > Realtime Database > Create (Singapore)
# 2) Rules tab: {"rules":{".read":false,".write":false}}  then Publish
# 3) Project settings > Service accounts > Generate new private key (downloads a JSON file)
# 4) Fill the 4 lines below from that JSON. Keep the private key in quotes, including \n.
# DB_PROVIDER=firebase
# FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR-PROJECT.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
